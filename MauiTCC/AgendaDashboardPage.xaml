<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTCC.AgendaDashboardPage"
             Title="Agenda do Consultório"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto, *">

        <Frame Grid.Row="0" Margin="15" Padding="15" CornerRadius="10" BackgroundColor="White" HasShadow="True">
            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Label Text="Filtrar Dia:" VerticalOptions="Center" FontAttributes="Bold" TextColor="Gray"/>
                <DatePicker x:Name="dtpFiltroData" Format="dd/MM/yyyy" WidthRequest="150" DateSelected="OnDataSelecionadaChanged"/>
                <Button Text="🔄 Limpar Filtro" Clicked="OnLimparFiltrosClicked" BackgroundColor="#607D8B" TextColor="White" HeightRequest="40"/>
            </HorizontalStackLayout>
        </Frame>

        <CollectionView Grid.Row="1" x:Name="collAgendamentos" Margin="15,0,15,15">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30" Spacing="10">
                    <Label Text="📭" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="Nenhuma consulta localizada para os filtros selecionados." TextColor="Gray" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5,0,5" Padding="15" CornerRadius="8" HasShadow="True" BackgroundColor="White">
                        <Grid ColumnDefinitions="*, Auto">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="👤 Paciente:" FontAttributes="Bold" TextColor="Gray"/>
                                    <Label Text="{Binding NomePaciente}" FontAttributes="Bold" TextColor="Black" FontSize="16"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="🩺 Dr(a):" TextColor="Gray"/>
                                    <Label Text="{Binding NomeDentista}" TextColor="#2196F3"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Data, StringFormat='📅 {0:dd/MM/yyyy}'}" TextColor="DarkSlateGray"/>
                                    <Label Text="{Binding Horario, StringFormat='⏰ {0}'}" FontAttributes="Bold" TextColor="DarkSlateGray"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SalaCadeira, StringFormat='📍 {0}'}" FontSize="12" TextColor="Gray"/>

                                <Frame BackgroundColor="#E3F2FD" BorderColor="#2196F3" Padding="5,2" CornerRadius="5" HorizontalOptions="Start" Margin="0,5,0,0">
                                    <Label Text="{Binding Status}" FontSize="11" TextColor="#2196F3" FontAttributes="Bold"/>
                                </Frame>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                <Button Text="Remarcar" 
                                        Clicked="OnRemarcarClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#FF9800" TextColor="White" FontSize="12" HeightRequest="35"/>
                                <Button Text="Cancelar" 
                                        Clicked="OnCancelarClicked" 
                                        CommandParameter="{Binding .}" 
                                        BackgroundColor="#F44336" TextColor="White" FontSize="12" HeightRequest="35"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>