<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTCC.CadastroUsuarioPage"
             Title="Cadastrar Funcionário"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="30">
            <Label Text="Novo Usuário do Sistema" FontSize="24" FontAttributes="Bold" TextColor="#2196F3" HorizontalOptions="Center" />

            <Entry x:Name="txtNome" Placeholder="Nome Completo" TextColor="Black" />
            <Entry x:Name="txtCPF" Placeholder="CPF (apenas números)" Keyboard="Numeric" TextColor="Black" />
            <Entry x:Name="txtSenha" Placeholder="Senha de Acesso" IsPassword="True" TextColor="Black" />

            <Label Text="Selecione o Nível de Acesso:" TextColor="Gray" Margin="0,10,0,0"/>
            <Picker x:Name="pckTipo" Title="Selecione o cargo" TextColor="Black">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Administrador</x:String>
                        <x:String>Recepcionista</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button Text="CADASTRAR FUNCIONÁRIO" 
                    Clicked="OnCadastrarUsuarioClicked" 
                    BackgroundColor="#2196F3" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>