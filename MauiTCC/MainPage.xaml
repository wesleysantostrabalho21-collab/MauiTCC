<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTCC.MainPage"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="Consultório Odontológico" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               TextColor="#2196F3"/>

        <Frame CornerRadius="10" Padding="0" BorderColor="#D0D0D0" BackgroundColor="White" >
            <Entry x:Name="txtUsuarioLogin" 
                   Placeholder="CPF (apenas números)" 
                   Keyboard="Numeric" 
                   HeightRequest="50"
                   TextColor="Black"/>
        </Frame>

        <Frame CornerRadius="10" Padding="0" BorderColor="#D0D0D0" BackgroundColor="White">
            <Entry x:Name="txtSenhaLogin" 
                   Placeholder="Senha" 
                   IsPassword="True" 
                   HeightRequest="50"
                   TextColor="Black"/>
        </Frame>

        <Button x:Name="btnLogin" Text="ACESSAR SISTEMA" Clicked="OnLoginClicked"
                BackgroundColor="#2196F3" 
                TextColor="White" 
                FontAttributes="Bold"
                HeightRequest="55"
                CornerRadius="10"/>

        <Label Text="Esqueceu a senha?" 
               HorizontalOptions="Center" 
               TextColor="Gray" 
               TextDecorations="Underline" />

            <Label
                Text="Welcome to &#10;.NET Multi-platform App UI"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />

            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

</ContentPage>

</ContentPage>
